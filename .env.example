# この見本を .env に写して値を入れる。.env は Git に入らない。
# Claude API の鍵（Claude Console で作る）
ANTHROPIC_API_KEY=

# デモだけのサーバーを Cloudflare Access の後ろに置く時（置き場所でだけ設定する）。二つはそろえるか、
# 全部空にする（一つだけなら起動しない）。そろえると、デモの API も要求ごとに Access のトークンを確かめる
# （/api/health を除く）。二つとも空なら守りの無い手元のデモなので、置き場所ではこの形で動かさない。
# 下の家族の家庭の四つと同じサーバーには設定しない（起動しない）。
# チームの発行元（https://<チーム>.cloudflareaccess.com）と、デモのアプリの AUD タグ
DEMO_ACCESS_TEAM_DOMAIN=
DEMO_ACCESS_AUD=

# 家族の家庭（置き場所でだけ設定する。手元のデモでは要らない）。下の四つは、そろえるか、全部空にする。
# Postgres（Railway）
DATABASE_URL=
# Cloudflare Access：チームの発行元（https://<チーム>.cloudflareaccess.com）と、アプリの AUD タグ
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=
# 画面の公開の Origin（書き込みは、この Origin から来た物だけを受ける）
APP_ORIGIN=
# 最初のログインで、大人に身元を結ぶ招き（家族の情報の id と、{"メール":"成員の id"} の JSON）。
# メールはリポジトリに書かない。結んだ後は使わない。
FAMILY_HOUSEHOLD_ID=
ACCESS_INVITES=

# 知らせ（Web Push）。三つそろった時だけ動かす（一部だけなら起動しない）。鍵は一度だけ作って .env に置く：
#   pnpm --filter @maniau/server exec web-push generate-vapid-keys
# VAPID_SUBJECT は事業者が困った時の連絡先（mailto: か https:）。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# 送った知らせの記録に残すアプリの版（無ければ Railway の RAILWAY_GIT_COMMIT_SHA）。
APP_VERSION=
